<?xml version="1.0"?>
<ruleset name="LifeAstroAPI PHP SDK">
    <description>PSR-12 for the library, tests, tools and examples.</description>

    <file>src</file>
    <file>tests</file>
    <file>tool</file>
    <file>examples</file>

    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg value="sp"/>

    <rule ref="PSR12"/>

    <!-- The PDF templates and locale tables hold long label strings (Indic text, CSS) copied
         verbatim from the Node.js SDK; their line length is not enforced. -->
    <rule ref="Generic.Files.LineLength">
        <exclude-pattern>src/Pdf/Templates/*</exclude-pattern>
        <exclude-pattern>src/Pdf/Locales.php</exclude-pattern>
    </rule>
</ruleset>
